# NexHire Backend Environment Configuration

ENV=development
PORT=8080

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nexhire?sslmode=disable

# Google OAuth Credentials (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# JWT Configuration
JWT_SECRET=super-secret-jwt-key-change-in-production

# Frontend Redirect URL
FRONTEND_URL=http://localhost:3000

GEMINI_API_KEY=your_gemini_api_key

# Resend (OTP emails). Gmail/Yahoo/Outlook cannot be used as EMAIL_FROM.
# Until you verify a domain at resend.com/domains, use the test sender
# and send only to the email on your Resend account.
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=NexHire <beth.t@example.com>